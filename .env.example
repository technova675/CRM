# ---- AI (optional — without it the CRM runs its local, rule-based AI engine) ----
# Provider: groq | openrouter | gateway. Leave empty to use the first one below that has a key.
AI_PROVIDER=
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OpenRouter (free ":free" models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Vercel AI Gateway key: https://vercel.com/ai-gateway  (or run `vercel env pull` on a linked project for OIDC)
AI_GATEWAY_API_KEY=
# Any AI Gateway model string
AI_MODEL=anthropic/claude-sonnet-5

# ---- Database (Neon Postgres, free tier): https://console.neon.tech ----
# Stores uploaded report files (Excel / CSV / PPTX). Pooled connection string:
DATABASE_URL=
# Direct (non-pooled) connection, used for creating tables:
DATABASE_URL_UNPOOLED=

# ---- Needed for production (not wired yet — see README "What's required") ----
# AUTH_SECRET=
# TOKEN_ENCRYPTION_KEY=          # 32-byte key for encrypting OAuth tokens at rest
# META_APP_ID= / META_APP_SECRET=
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET= / GOOGLE_ADS_DEVELOPER_TOKEN=
# LINKEDIN_CLIENT_ID= / LINKEDIN_CLIENT_SECRET=
# WHATSAPP_TOKEN= / WHATSAPP_PHONE_NUMBER_ID=
# RESEND_API_KEY=                # or SMTP / Gmail OAuth for outbound email
# RAZORPAY_KEY_ID= / RAZORPAY_KEY_SECRET=
