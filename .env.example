# ---- AI (optional — without it the CRM runs its local, rule-based AI engine) ----
# Provider: groq | openrouter | gateway. Leave empty to use the first one below that has a key.
AI_PROVIDER=
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OpenRouter (free ":free" models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Vercel AI Gateway key: https://vercel.com/ai-gateway  (or run `vercel env pull` on a linked project for OIDC)
AI_GATEWAY_API_KEY=
# Any AI Gateway model string
AI_MODEL=anthropic/claude-sonnet-5

# ---- Reporting database (Supabase): https://supabase.com/dashboard ----
# Use the project's HTTPS URL. DATABASE_URL and DATABASE_URL_UNPOOLED are not used.
NEXT_PUBLIC_SUPABASE_URL=
# Public project anon/publishable key for Supabase Auth (never the service_role key):
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional server-only URL override:
SUPABASE_URL=
# Server-only service_role JWT (or use SUPABASE_SECRET_KEY for an sb_secret_ key).
# Never prefix this key with NEXT_PUBLIC_. No browser database access is needed.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
# Apply all SQL files in supabase/migrations/ in filename order in the project's SQL Editor.

# ---- Private report file storage (Cloudflare R2) ----
# Set r2 to require R2 for new uploads. Existing Supabase reports remain readable.
# Leave unset with no R2 keys to retain Supabase storage during setup.
REPORT_FILE_STORAGE=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Use a bucket-scoped Object Read & Write API token. Keep the bucket private.
# These credentials are server-only; never use NEXT_PUBLIC_ for them.

# ---- Needed for production (not wired yet — see README "What's required") ----
# AUTH_SECRET=
# TOKEN_ENCRYPTION_KEY=          # 32-byte key for encrypting OAuth tokens at rest
# META_APP_ID= / META_APP_SECRET=
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET= / GOOGLE_ADS_DEVELOPER_TOKEN=
# LINKEDIN_CLIENT_ID= / LINKEDIN_CLIENT_SECRET=
# WHATSAPP_TOKEN= / WHATSAPP_PHONE_NUMBER_ID=
# RESEND_API_KEY=                # or SMTP / Gmail OAuth for outbound email
# RAZORPAY_KEY_ID= / RAZORPAY_KEY_SECRET=

# Optional broader public discovery for the AI Lead Research Agent.
# Without this, the agent reads the supplied website and social profiles and labels search gaps.
TAVILY_API_KEY=

# Optional approved delivery adapter. Leave blank to keep sending disabled.
# Provider must support the idempotency and signed webhook contract in README.md.
OUTREACH_DELIVERY_URL=
OUTREACH_DELIVERY_TOKEN=
OUTREACH_APPROVED_CHANNELS=Email
OUTREACH_WEBHOOK_SECRET=
# Optional separate signing key; otherwise the server service key signs approvals.
OUTREACH_APPROVAL_SECRET=
