# ---- AI (optional — without it the CRM runs its local, rule-based AI engine) ----
# Provider: groq | openrouter | gateway. Leave empty to use the first one below that has a key.
AI_PROVIDER=
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OpenRouter (free ":free" models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Existing installations may also use OPENROUTER_API_KEY1; the primary name takes precedence.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Vercel AI Gateway key: https://vercel.com/ai-gateway  (or run `vercel env pull` on a linked project for OIDC)
AI_GATEWAY_API_KEY=
# Any AI Gateway model string
AI_MODEL=anthropic/claude-sonnet-5

# Lead Research uses the selected free OpenRouter model independently of other AI modules.
# Research has two AI passes (research + evidence review), consuming two AI credits.
# There is no automatic fallback to a different model for research.
AI_RESEARCH_PROVIDER=openrouter
AI_RESEARCH_MODEL=nvidia/nemotron-3.5-super-vl:free
AI_RESEARCH_FREE_ONLY=true
# Requires OPENROUTER_API_KEY above. No paid-model fallback is used.
FIRECRAWL_API_KEY=
# Use a Firecrawl Free account for its free allowance; the app never upgrades plans or tops up credits.

# ---- Reporting database (Supabase): https://supabase.com/dashboard ----
# Use the project's HTTPS URL. DATABASE_URL and DATABASE_URL_UNPOOLED are not used.
NEXT_PUBLIC_SUPABASE_URL=
# Public project anon/publishable key for Supabase Auth (never the service_role key):
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional server-only URL override:
SUPABASE_URL=
# Server-only service_role JWT (or use SUPABASE_SECRET_KEY for an sb_secret_ key).
# Never prefix this key with NEXT_PUBLIC_. No browser database access is needed.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
# Apply all SQL files in supabase/migrations/ in filename order in the project's SQL Editor.

# ---- Private report file storage (Cloudflare R2) ----
# Set r2 to require R2 for new uploads. Existing Supabase reports remain readable.
# Leave unset with no R2 keys to retain Supabase storage during setup.
REPORT_FILE_STORAGE=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Use a bucket-scoped Object Read & Write API token. Keep the bucket private.
# These credentials are server-only; never use NEXT_PUBLIC_ for them.

# ---- Needed for production (not wired yet — see README "What's required") ----
# AUTH_SECRET=
# TOKEN_ENCRYPTION_KEY=          # 32-byte key for encrypting OAuth tokens at rest
# META_APP_ID= / META_APP_SECRET=
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET= / GOOGLE_ADS_DEVELOPER_TOKEN=
# LINKEDIN_CLIENT_ID= / LINKEDIN_CLIENT_SECRET=
# WHATSAPP_TOKEN= / WHATSAPP_PHONE_NUMBER_ID=
# RESEND_API_KEY=                # or SMTP / Gmail OAuth for outbound email
# RAZORPAY_KEY_ID= / RAZORPAY_KEY_SECRET=

# ---- Transactional email (Brevo): client onboarding welcome emails ----
# API key from Brevo → SMTP & API → API keys. The sender must be a verified sender on an authenticated domain.
# Sign-up confirmation and password-reset emails are sent by Supabase Auth: set Brevo's SMTP relay in
# Supabase → Authentication → Emails → SMTP Settings (see README). Do not use this for cold outreach.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_REPLY_TO=
# Optional broader public discovery for the AI Lead Research Agent.
# Without this, the agent reads the supplied website and social profiles and labels search gaps.
TAVILY_API_KEY=

# Optional approved delivery adapter. Leave blank to keep sending disabled.
# Provider must support the idempotency and signed webhook contract in README.md.
OUTREACH_DELIVERY_URL=
OUTREACH_DELIVERY_TOKEN=
OUTREACH_APPROVED_CHANNELS=Email
OUTREACH_WEBHOOK_SECRET=
# Optional separate signing key; otherwise the server service key signs approvals.
OUTREACH_APPROVAL_SECRET=

# Optional authorized, owner-scoped, read-only media connector (see README contract).
# Tokens stay server-side. Without this connector, use the Performance CSV importer.
MEDIA_CONNECTOR_URL=
MEDIA_CONNECTOR_TOKEN=

# Optional authorized social scheduler/listening adapter (README contract).
# Planned dates remain local planning until this adapter confirms a schedule.
SOCIAL_CONNECTOR_URL=
SOCIAL_CONNECTOR_TOKEN=

# Read-only native Google Search Console integration (server only).
# JSON for a Google service account granted access to your Search Console property.
# Bind its use to one authenticated CRM owner's UUID; no browser access tokens.
GSC_SERVICE_ACCOUNT_JSON=
GSC_ALLOWED_OWNER_ID=

# Optional Marketing Automation worker and approved Email delivery adapter.
# See docs/marketing-automation.md. Keep all secrets server-only.
# Scheduled automations: a scheduler calls GET /api/automations/cron with "Authorization: Bearer $CRON_SECRET".
# Vercel Cron sends this header automatically (vercel.json, daily on the Hobby plan). The GitHub Actions workflow
# .github/workflows/automations-cron.yml calls it every 5 minutes: add CRON_SECRET as a repository secret and
# APP_URL as a repository variable. On Vercel Pro you can set the vercel.json schedule to "* * * * *" instead.
# Use a random value of at least 16 characters.
CRON_SECRET=
# Optional self-hosted alternative: scripts/automation-worker.mjs, one account per listed ID.
AUTOMATION_WORKER_SECRET=
AUTOMATION_WORKER_OWNER_IDS=
AUTOMATION_WORKER_BASE_URL=http://localhost:3012
AUTOMATION_DELIVERY_URL=
AUTOMATION_DELIVERY_TOKEN=

# Analytics Engine read-only adapter (optional)
ANALYTICS_CONNECTOR_URL=
ANALYTICS_CONNECTOR_TOKEN=
ANALYTICS_CONNECTOR_OWNER_IDS=

# Optional attachment-capable client reporting delivery adapter
CLIENT_REPORT_DELIVERY_URL=
CLIENT_REPORT_DELIVERY_TOKEN=

# Optional server-managed plan overrides keyed by the workspace owner's Supabase Auth UUID.
# Use one JSON object with values Starter, Growth, Agency, or Enterprise.
ADBIBE_TENANT_PLANS={}

# ---- Meetings: calendar connections (one per login, read-only) ----
# Calendly: "Sign in with Calendly" needs an OAuth app from https://developer.calendly.com (My apps > Create new app,
# kind "Web", environment Sandbox for localhost or Production for the live domain) with redirect URI
# https://<your-domain>/api/calendar/calendly/callback (http://localhost:3011/api/calendar/calendly/callback in Sandbox).
# Without it, users can still paste a Calendly personal access token.
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
# Cal.com connects with the user's own API key (Cal.com offers OAuth only to its paid Platform customers).
# Google Calendar needs an OAuth client: Google Cloud Console > APIs & Services > enable "Google Calendar API",
# OAuth consent screen (scope .../auth/calendar.readonly), then Credentials > OAuth client ID (Web application)
# with Authorized redirect URI https://<your-domain>/api/calendar/google/callback (and http://localhost:3011/... for dev).
# All stored tokens are encrypted with WORKSPACE_VAULT_KEY.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Optional Google OAuth. Configure Google in Supabase and allow this app's /auth/callback URL.
NEXT_PUBLIC_GOOGLE_OAUTH=false

# Persistent server-only 32-byte hex key for organization vaults and signed backups.
# Keep a secure offline copy. Replacing it invalidates old backups and stored credentials.
WORKSPACE_VAULT_KEY=
# Required only when using the legacy deployment-level MEDIA_CONNECTOR_TOKEN.
MEDIA_CONNECTOR_ALLOWED_OWNER_ID=
